# Banco de dados — usar asyncpg para a aplicação
DATABASE_URL=postgresql+asyncpg://usuario:senha@localhost:5432/hortifacil

# Banco de dados — usar psycopg2 para as migrations do Alembic (sync)
DATABASE_URL_SYNC=postgresql+psycopg2://usuario:senha@localhost:5432/hortifacil

# Segurança — gerar com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque_por_uma_chave_segura_gerada_aleatoriamente
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Ambiente
ENVIRONMENT=development

# Emissão fiscal (NFC-e): none = desligada | fake = só desenvolvimento.
# Token do provedor e CSC entram aqui, nunca no repositório.
FISCAL_PROVIDER=none
# Reenvio automático de NFC-e pendentes por falha do provedor (segundos; 0 desliga).
FISCAL_RETRY_INTERVAL_SECONDS=120
# Chave mestra (32 bytes em base64) que cifra o certificado digital e o CSC guardados no banco.
# Gere com: python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Guarde só aqui e no Coolify; perdê-la obriga a cadastrar de novo o certificado e o CSC.
FISCAL_SECRET_KEY=
DEBUG=true

# CORS — origens permitidas (separadas por vírgula)
# Em produção: adicionar o domínio do frontend
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
